#@vscode/codicons now publishes exclusively prerelease-style versions (its `latest` dist-tag is
#0.0.46-24), and semver excludes prereleases from ordinary ranges, so @vscode-elements/elements'
#`@vscode/codicons >=0.0.40` peer requirement can never be satisfied by any modern codicons.
#Skip strict peer resolution here so fresh installs (including the root postinstall and CI) work.
legacy-peer-deps=true
